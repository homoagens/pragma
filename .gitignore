env/

# Skills in testing (wip_ prefix — rename folder to publish)
core/skills/wip_*/

# Pragma runtime / local files
*.log
todo.json

# The endpoint list the monitor remembers: ports are a fact about one machine
# (and over a tunnel they are the tunnel's, not the server's), never the project's
tools/endpoint_monitor.local.json

# Local-only docs (not for publication)
MANUAL.md

# Local-only memory demos / walkthroughs (script + generated log)
research/

# IDE
.vscode/
.idea/
.obsidian/

# OS
.DS_Store
Thumbs.db

# Zenodo deposit staging: the exact bundle uploaded as the paper artefacts.
# Local mirror of what is published; never part of the code repository.
zenodo-artifacts/
pragma-memory-artifacts-*.zip
README-zenodo-record.md

# Undo snapshots written by the agent into a workspace (core/checkpoint.py)
.pragma_checkpoints/
sandbox/

# Superseded entry points, kept on the machine that still has muscle memory
