# Line endings, decided here rather than by whoever cloned.
#
# The shell entry point keeps LF wherever it is checked out: a #!/bin/sh with
# CRLF is a script Linux refuses to run, and a clone made on Windows, with
# core.autocrlf on, is still opened from WSL.
pragma  text eol=lf
*.sh    text eol=lf

# Everything else follows the working tree, normalised in the repository.
*       text=auto

# Binary, never touched.
*.png   binary
*.gif   binary
*.mp4   binary
*.zip   binary
*.gguf  binary
