# Line endings, decided here rather than by whoever cloned.
#
# core.autocrlf is on by default on Windows, which rewrites every checked-out
# text file to CRLF. cmd.exe wants exactly that, and a .bat with bare LF can
# mis-execute a multi-line command - so the Windows entry points are pinned
# rather than left to a setting each clone decides for itself.

*.bat   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# Everything else follows the working tree, normalised in the repository.
*       text=auto

# Binary, never touched.
*.png   binary
*.gif   binary
*.zip   binary
*.gguf  binary
