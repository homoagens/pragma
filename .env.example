# Pragma — environment configuration
# Copy this file to .env and fill in your values (or run: configure).
# .env is never committed to git.

# ── LLM endpoint (OpenAI-compatible) ──────────────────────────────────────────
# Pragma calls POST {LLM_BASE_URL}/chat/completions. LLM_BASE_URL MUST end in /v1.
# Pick the one that matches your server:
#   llama.cpp : http://127.0.0.1:8080/v1
#   LM Studio : http://127.0.0.1:1234/v1
#   Ollama    : http://127.0.0.1:11434/v1
#   vLLM      : http://127.0.0.1:8000/v1
#   OpenAI    : https://api.openai.com/v1     (then set LLM_API_KEY=sk-...)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
DEFAULT_MODEL=your-model-name

# ── Coding model (optional) ───────────────────────────────────────────────────
# Route the `code` skill to a specialized coding model. Defaults to
# DEFAULT_MODEL if not set. Set CODING_BASE_URL only if it lives on another
# OpenAI-compatible server.
# CODING_MODEL=qwen2.5-coder-14b
# CODING_BASE_URL=http://127.0.0.1:8080/v1
# CODING_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# Single folder for everything Pragma persists: conversations, learnings,
# log, and the uploaded .env. Default: a ".pragma" folder in your home
# directory (~/.pragma) — same path on every OS, no admin rights needed.
# Uncomment only to relocate the whole data folder elsewhere.
# PRAGMA_DATA_DIR=D:\pragma-data          (Windows)
# PRAGMA_DATA_DIR=/home/me/pragma-data    (Linux/macOS)

# ── Self-integrity guard ──────────────────────────────────────────────────────
# Pragma never modifies its own files: the file-mutating skills refuse any
# write anywhere inside the Pragma repository. Set this to true ONLY if you
# are a developer who intentionally wants to edit Pragma itself through a
# Pragma session. Leave it unset (or false) for normal use.
# PRAGMA_ALLOW_SELF_MODIFY=true

# ── Debug ─────────────────────────────────────────────────────────────────────
# PRAGMA_DEBUG=true
