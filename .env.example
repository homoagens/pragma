# Pragma — environment configuration
# Copy this file to .env and fill in your values (or run: configure).
# .env is never committed to git.

# ── LLM endpoint (OpenAI-compatible) ──────────────────────────────────────────
# Pragma calls POST {LLM_BASE_URL}/chat/completions. LLM_BASE_URL MUST end in /v1.
# Pick the one that matches your server:
#   llama.cpp : http://127.0.0.1:8080/v1
#   LM Studio : http://127.0.0.1:1234/v1
#   Ollama    : http://127.0.0.1:11434/v1
#   vLLM      : http://127.0.0.1:8000/v1
#   OpenAI    : https://api.openai.com/v1     (then set LLM_API_KEY=sk-...)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
# Leave DEFAULT_MODEL empty and Pragma asks the endpoint what it is serving,
# which cannot go stale when another model is loaded on the same port. Set it
# only when the endpoint hosts several models and this field selects one.
DEFAULT_MODEL=

# ── Coding model (optional) ───────────────────────────────────────────────────
# Route the `code` skill to a specialized coding model. Defaults to
# DEFAULT_MODEL if not set. Set CODING_BASE_URL only if it lives on another
# OpenAI-compatible server.
# CODING_MODEL=qwen2.5-coder-14b
# CODING_BASE_URL=http://127.0.0.1:8080/v1
# CODING_API_KEY=

# ── Model limits ──────────────────────────────────────────────────────────────
# CONTEXT_WINDOW (tokens) MUST match the -c value of your llama-server — if
# they disagree, memory compression triggers at the wrong time.
# MAX_TOKENS is the output budget for one reply (default 16384). It has to
# fit a whole write_file, so the file size sets the floor: at 4096 the
# benchmark produced generations cut off mid-string inside a Python source
# file. Keep MAX_TOKENS + the compressed prompt (~55% of CONTEXT_WINDOW)
# inside CONTEXT_WINDOW; on a smaller window, lower both together.
# SKILL_MAX_TOKENS is the budget for internal calls (edit_file, code, and
# the memory faculties) and follows MAX_TOKENS. What they emit is short, but
# a thinking model reasons first and emits JSON last, so a tight budget cuts
# off exactly the part that matters. Lower it if you want the faculties
# terser — the budget bounds how much they write, not only how often they
# fail.
# LLM_TIMEOUT is the per-call HTTP timeout in seconds (default 900): a full
# 16k generation at 40 tok/s already takes 400s.
# CONTEXT_WINDOW=65536
# MAX_TOKENS=16384
# CODING_MAX_TOKENS=16384
# SKILL_MAX_TOKENS=16384
# LLM_TIMEOUT=900

# ── Memory — forgetting (episodic store) ─────────────────────────────────────
# An episode's effective salience decays with the time since its last
# recall: eff = salience * 0.5^(age_days / half_life). Recall resets the
# age. Below the threshold an episode moves to the dormant zone (out of
# active search, revivable when a query matches it again). True deletion
# only after EPISODE_DELETE_AFTER_DAYS in dormancy and only for episodes
# nothing references; 0 = never delete (default).
# EPISODE_DECAY_HALF_LIFE_DAYS=30
# EPISODE_DORMANT_THRESHOLD=0.15
# EPISODE_DELETE_AFTER_DAYS=0

# ── Storage ───────────────────────────────────────────────────────────────────
# Single folder for everything Pragma persists: conversations, learnings,
# log, and the uploaded .env. Default: a ".pragma" folder in your home
# directory (~/.pragma) — same path on every OS, no admin rights needed.
# Uncomment only to relocate the whole data folder elsewhere.
# PRAGMA_DATA_DIR=D:\pragma-data          (Windows)
# PRAGMA_DATA_DIR=/home/me/pragma-data    (Linux/macOS)

# ── Self-integrity guard ──────────────────────────────────────────────────────
# Pragma never modifies its own files: the file-mutating skills refuse any
# write anywhere inside the Pragma repository. Set this to true ONLY if you
# are a developer who intentionally wants to edit Pragma itself through a
# Pragma session. Leave it unset (or false) for normal use.
# PRAGMA_ALLOW_SELF_MODIFY=true

# ── Debug ─────────────────────────────────────────────────────────────────────
# PRAGMA_DEBUG=true
