# Pragma — environment configuration
# Copy this file to .env and fill in your values.
# .env is never committed to git.

# ── Option 1: Ollama (local, free) ────────────────────────────────────────────
# Install Ollama from https://ollama.com, then: ollama pull llama3.2
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
DEFAULT_MODEL=llama3.2

# ── Option 2: OpenAI ──────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# DEFAULT_MODEL=gpt-4o-mini

# ── Option 3: Anthropic ───────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# DEFAULT_MODEL=claude-haiku-4-5

# ── Option 4: Groq, Mistral, DeepSeek, OpenRouter... ─────────────────────────
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# DEFAULT_MODEL=llama-3.3-70b-versatile

# ── Coding model (optional) ───────────────────────────────────────────────────
# Route the `code` skill to a specialized coding model.
# Defaults to DEFAULT_MODEL if not set.
# CODING_MODEL=qwen2.5-coder:14b
# CODING_PROVIDER=openai
# CODING_BASE_URL=http://localhost:11434/v1

# ── Custom backend proxy (advanced) ──────────────────────────────────────────
# If you run your own inference proxy with a non-standard response schema.
# LLM_PROVIDER=backend
# BACKEND_URL=http://your-proxy-host:port
# BACKEND_KEY=your-key
# DEFAULT_MODEL=your-model-name

# ── Storage ───────────────────────────────────────────────────────────────────
# Where threads (conversations) are stored on disk.
# PRAGMA_DATA_DIR=C:\tmp\pragma      (Windows)
# PRAGMA_DATA_DIR=/tmp/pragma        (Linux/macOS)

# ── Self-integrity guard ──────────────────────────────────────────────────────
# Pragma never modifies its own source code: the file-mutating skills refuse
# any write inside core/ and agent/. Set this to true ONLY if you are a
# developer who intentionally wants to edit Pragma itself through a Pragma
# session. Leave it unset (or false) for normal use.
# PRAGMA_ALLOW_SELF_MODIFY=true

# ── Debug ─────────────────────────────────────────────────────────────────────
# PRAGMA_DEBUG=true
